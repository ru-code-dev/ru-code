{
  "name": "@ru-code/ru-code",
  "version": "3.0.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ru-code-dev/ru-code",
    "directory": "apps/server"
  },
  "bin": {
    "ru-fork": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bin.ts start",
    "build": "node scripts/cli.ts build",
    "build:bundle": "tsdown",
    "build:preflight": "tsdown --config tsdown.preflight.config.ts",
    "start": "node dist/bin.mjs start --port 8080",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "test": "vitest run --coverage",
    "test:fast": "vitest run"
  },
  "dependencies": {
    "msgpackr-extract": "3.0.3",
    "node-pty": "1.2.0-beta.12"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@pierre/diffs": "1.1.20",
    "@ru-fork/branding": "workspace:*",
    "@ru-fork/mcp-core": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "effect": "catalog:",
    "effect-acp": "workspace:*",
    "open": "10.1.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
