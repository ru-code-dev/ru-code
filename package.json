{
  "name": "@ru-code/monorepo",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ru-code-dev/ru-code.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "start": "NODE_OPTIONS='--experimental-strip-types --experimental-sqlite' turbo run start --filter=@ru-code/ru-code",
    "build": "NODE_OPTIONS='--experimental-strip-types --experimental-sqlite' turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "NODE_OPTIONS='--experimental-strip-types --experimental-sqlite' turbo run test",
    "test:fast": "NODE_OPTIONS='--experimental-strip-types --experimental-sqlite' turbo run test:fast",
    "lint": "NODE_OPTIONS='--experimental-strip-types --experimental-sqlite' oxlint --report-unused-disable-directives",
    "fmt": "NODE_OPTIONS='--experimental-strip-types --experimental-sqlite' oxfmt",
    "fmt:check": "oxfmt --check",
    "build:contracts": "turbo run build --filter=@t3tools/contracts",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist .turbo apps/*/.turbo packages/*/.turbo",
    "sync:vscode-icons": "node scripts/sync-vscode-icons.mjs",
    "prepare-release": "NODE_OPTIONS='--experimental-strip-types --experimental-sqlite' node scripts/prepare-release.ts",
    "change": "beachball change --no-commit"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@oxlint/plugins": "^1.63.0",
    "@types/node": "catalog:",
    "beachball": "2.51.0",
    "oxfmt": "0.40.0",
    "oxlint": "1.63.0",
    "turbo": "2.9.8",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10",
    "pnpm": ">=10.15.0"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "overrides": {
      "@effect/atom-react": "4.0.0-beta.59",
      "@effect/platform-node": "4.0.0-beta.59",
      "@effect/platform-node-shared": "4.0.0-beta.59",
      "effect": "4.0.0-beta.59",
      "vite": "8.0.10"
    },
    "onlyBuiltDependencies": [
      "node-pty",
      "msgpackr-extract"
    ]
  },
  "beachball": {
    "branch": "ru-code",
    "registry": "https://registry.npmjs.org"
  }
}
