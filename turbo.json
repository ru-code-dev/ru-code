{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "HOST",
    "PORT",
    "VITE_WS_URL",
    "VITE_DEV_SERVER_URL",
    "RU_FORK_LOG_LEVEL",
    "RU_FORK_LOG_WS_EVENTS",
    "RU_FORK_MODE",
    "RU_FORK_PORT",
    "RU_FORK_NO_BROWSER",
    "RU_FORK_HOME",
    "RU_FORK_AUTH_TOKEN",
    "NODE_OPTIONS"
  ],
  "globalPassThroughEnv": ["PATHEXT", "NODE_OPTIONS", "RU_FORK_CLI_JS", "RU_FORK_FAKE_ACP"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "dist-electron/**"]
    },
    "dev": {
      "dependsOn": ["@t3tools/contracts#build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "test:fast": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
